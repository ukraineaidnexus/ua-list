{{/* One detail page per creator.
     EnableAllLanguages: detail pages are now per-language, using the same
     field-lang.html priority as cards. See DATA.md. */}}
{{ .EnableAllLanguages }}
{{ range $file, $c := site.Data.creators }}
  {{ if $c.draft }}{{ continue }}{{ end }}
  {{ $title := partial "field-lang.html" (dict "entry" $c "field" "name") }}
  {{ $history := partial "field-lang.html" (dict "entry" $c "field" "history") }}
  {{ $content := dict "mediaType" "text/markdown" "value" $history }}
  {{ $.AddPage (dict
    "path" $c.id
    "title" $title
    "kind" "page"
    "params" (dict "c" $c)
    "content" $content
  ) }}
{{ end }}
